# Copy this file to .env.local and fill in real values.
# .env.local is gitignored so secrets never enter the repo.

# Supabase project URL — Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase publishable key (sb_publishable_...). Safe to ship in client code.
VITE_SUPABASE_KEY=sb_publishable_REPLACE_ME

# Stripe price ID for the SkyFlag Plus subscription. Get this from
# Stripe Dashboard → Products → Plus → Pricing → API ID. Format:
# price_1ABC... When unset, the upgrade panel hides (pre-launch mode).
VITE_STRIPE_PRICE_PLUS=price_REPLACE_ME
