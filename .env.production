# Production env values picked up by Vite during `npm run build`.
# These are PUBLISHABLE / anon credentials — designed to be public and
# protected by Supabase Row Level Security policies. Committing them is
# safe and required so that Xcode Cloud (which clones a fresh checkout
# without the gitignored .env.local) bakes them into the iOS bundle.
VITE_SUPABASE_URL=https://oeychcbxvuozkvfjcwlr.supabase.co
VITE_SUPABASE_KEY=sb_publishable_NHd1KoPRoqTIEleWs-JBAw_qyyI6sYW

# VAPID public key for Web Push — safe to ship in client code (analog of an
# OAuth client ID). The matching PRIVATE key lives only in Supabase Edge
# Function secrets and is never committed.
VITE_VAPID_PUBLIC_KEY=BEkcuZByve0VEGCzcqNF6qJwf4bFiAvYqNB_f2C7SG-iWmTN8dXiLTbFaBKHHpmWFGRCWBEMV8QbRB504XgjvkE

# Stripe price ID for 3phor Plus. Test price during development; will
# be swapped for the live-mode price ID at launch. The matching secret
# key + webhook signing secret live in Supabase secrets.
VITE_STRIPE_PRICE_PLUS=price_1TVHCz7vcJP4gfs9vNUz02Dq
