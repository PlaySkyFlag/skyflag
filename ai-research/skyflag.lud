// ============================================================================
// Skyflag — Ludii ludeme spec  (Stage A grounded in real Ludii game files)
// ============================================================================
//
// STATUS: still NOT run through the Ludii compiler here (no Java/Ludii in the
// authoring env), BUT — unlike the first draft — every ludeme below is adapted
// from a REAL, shipped Ludii game file, cited inline, instead of written from
// memory. That is the whole point: copy known-good syntax, don't hallucinate it.
//
// Source files (fetched from github.com/Ludeme/Ludii, v1.3.x):
//   [Shogi]   board/war/replacement/checkmate/shogi/Shogi.lud   — hand drops,
//             StepMove/SlideMove+capture, promotion, ("SameTurn")+(move Pass)
//   [Chess]   board/war/replacement/checkmate/chess/Chess.lud    — pawn: forward
//             -empty + diagonal-capture + double-first-move via (sites Start)
//   [Connect6] board/space/line/Connect6.lud                     — 2 actions per
//             turn via (then (moveAgain))
//   [Agon]    board/race/fill/Agon.lud                           — limited slide
//             (between (max 1) ...) = move 1 or 2, no jump
//   [3DTTT]   board/space/line/3D Tic-Tac-Toe.lud                — 3D as a tall
//             flattened board, vertical links via (ahead (site) steps:N)
//
// ACCEPTANCE TEST (unchanged): Ludii perft from the opening, one edge = one
// activation, forced pass included, must reproduce  4 / 17 / 68 / 289 / 2499
// at depth 1–5 (RULES.md §8, TS oracle `npm run analyze perft`).
//
// REMAINING [CHK]/[HARD] markers flag the spots most likely to need compiler
// iteration even though the surrounding syntax is now grounded.
//
// ----------------------------------------------------------------------------
// Reusable move defines (adapted from [Shogi] "StepMove"/"SlideMove")
// ----------------------------------------------------------------------------

(define "CaptureByLanding"     // [Shogi] CapturePiece, simplified: no hand re-use
    (apply (if (is Enemy (who at:(to))) (remove (to))))
)

// Captain: king step, 8 directions, capture by landing.  [Shogi] Osho = bare
// ("StepMove"); Step with no direction arg = all adjacent.
(define "CaptainMove"
    (move Step
        (to if:(not (is Friend (who at:(to)))) "CaptureByLanding")
        "OfferSecondActivation"
    )
)

// Rover: orthogonal, distance 1 OR 2, no jump, capture by landing.
// [Agon] (between (max 1) if:(is Empty (between)))  → exactly 1 intermediate
// empty cell, i.e. reach 1 or 2 away without jumping.
(define "RoverMove"
    (move Slide Orthogonal
        (between (max 1) if:(is Empty (between)))
        (to if:(not (is Friend (who at:(to)))) "CaptureByLanding")
        "OfferSecondActivation"
    )
)

// Pilot: same as Rover but diagonal.
(define "PilotMove"
    (move Slide Diagonal
        (between (max 1) if:(is Empty (between)))
        (to if:(not (is Friend (who at:(to)))) "CaptureByLanding")
        "OfferSecondActivation"
    )
)

// Soldier: chess pawn.  [Chess] forward step to empty; [Chess] diagonal-forward
// capture; [Chess] double first move via (sites Start ...). Promotion is
// AUTOMATIC (always → Captain), so NO (moveAgain) for a promotion choice — which
// keeps the only moveAgain in the turn the second-activation one.
(define "SoldierMove"
    (or {
        // forward 1 to an empty square (no forward capture)
        (move Step Forward (to if:(is Empty (to))))
        // double first move, only from the piece's start site, both squares empty.
        // [Chess] does this with a dedicated "DoubleStepForwardToEmpty" define —
        // lift that body verbatim rather than improvising the 2-step ludeme. [CHK]
        (if (is In (from) (sites Start (piece (what at:(from)))))
            ("DoubleStepForwardToEmpty"))
        // diagonal-forward capture only
        (move Step (directions {FR FL})
            (to if:(is Enemy (who at:(to))) "CaptureByLanding"))
       }
       (then ("PromoteThenOfferSecond"))
    )
)

// [Chess] lift the real body from chess/Chess.lud "DoubleStepForwardToEmpty"
// (it steps two forward requiring the intermediate + destination empty). Stubbed
// here as a single forward step so the file is self-contained until you paste it.
(define "DoubleStepForwardToEmpty"
    (move Step Forward (to if:(is Empty (to))))   // [HARD] replace with Chess's 2-step define
)

// Promotion + second-activation offer, combined.  [Shogi] (move Promote ...),
// [Connect6] (moveAgain). [HARD] verify a piece-level (then ...) composes with
// the play-level turn control — this is the single least-certain interaction.
(define "PromoteThenOfferSecond"
    (and
        (if (is In (last To) (sites Mover "Promotion"))
            (promote (last To) (piece "Captain") Mover))
        ("OfferSecondActivation")
    )
)

// Grant the 2nd activation only when this was the 1st.  [Connect6] moveAgain;
// ("SameTurn") true means we are already in the granted 2nd activation.
// [HARD] confirm ("SameTurn")/(count MovesThisTurn) semantics give exactly
// "≤2 activations, 2nd optional".
(define "OfferSecondActivation"
    (then (if (not ("SameTurn")) (moveAgain)))
)

// ----------------------------------------------------------------------------
// STAGE A — single-layer flat foundation (6x6, no lifts / layers yet)
// ----------------------------------------------------------------------------

(game "Skyflag (flat)"
    ("TwoPlayersNorthSouth")   // [Shogi]/[Chess] — sets Forward/Backward per player

    (equipment {
        (board (square 6))

        (piece "Captain" Each "CaptainMove")
        (piece "Soldier" Each "SoldierMove")
        (piece "Rover"   Each "RoverMove")
        (piece "Pilot"   Each "PilotMove")

        (hand Each size:4)

        // far row = promotion zone (P1 row 5 / P2 row 0). [Shogi] regions form.
        (regions "Promotion" P1 (sites Top))
        (regions "Promotion" P2 (sites Bottom))

        // single deploy pad per player (Skyflag Meridian pad, flattened): P1 (0,3),
        // P2 (5,2). [Shogi] drops, but restricted to a 1-cell region.
        (regions "DeployPad" P1 (sites {"D1"}))
        (regions "DeployPad" P2 (sites {"C6"}))

        // Stage-A win marker: the enemy flag site a Captain must reach.
        // Skyflag sky flags: P1 (0,5) "F1", P2 (5,0) "A6".
        (regions "EnemyFlag" P1 (sites {"A6"}))   // P1 attacks P2's flag
        (regions "EnemyFlag" P2 (sites {"F1"}))   // P2 attacks P1's flag
    })

    (rules
        (start {
            // all four pieces begin in hand (size-4 hand, one of each).
            (place "Captain" "Hand" count:1)
            (place "Soldier" "Hand" count:1)
            (place "Rover"   "Hand" count:1)
            (place "Pilot"   "Hand" count:1)
        })

        // Turn = up to 2 activations. [Shogi] play shape: a ("SameTurn") branch
        // for the continuation vs the fresh-turn branch.
        (play
            (if ("SameTurn")
                // 2nd activation: another deploy/move, OR pass (= Skyflag's
                // end-turn-early). No further moveAgain → turn ends after this.
                (or {
                    ("DeployMove")
                    (forEach Piece)
                    (move Pass)
                })
                // 1st activation: deploy or move; each ends with
                // "OfferSecondActivation" → (moveAgain) for the 2nd.
                (or {
                    ("DeployMove")
                    (forEach Piece)
                })
            )
        )

        (end {
            // Stage-A win: a Captain reaches the enemy flag site.
            (if (and (= (id "Captain" Mover) (what at:(last To)))
                     (is In (last To) (sites Mover "EnemyFlag")))
                (result Mover Win))
            // elimination: no Captain and no Soldier left (board or hand). [CHK]
            (if (no Pieces Mover "Captain" "Soldier") (result Next Win))
        })
    )
)

// Deploy a hand piece onto the (empty) deploy pad. [Shogi] drop, region-limited.
(define "DeployMove"
    (move
        (from (sites Occupied by:Mover container:"Hand"))
        (to (intersection (sites Mover "DeployPad") (sites Empty)))
        "OfferSecondActivation"
    )
)

// ----------------------------------------------------------------------------
// STAGE B — 3D extension plan (notes; cite [3DTTT])
// ----------------------------------------------------------------------------
//
// Recommended model = the [3DTTT] FLATTENED-RECTANGLE board, NOT a stacking
// (Score Four `stack:True`) board — Skyflag pieces MOVE WITHIN a layer, they do
// not pile on a cell.
//
//   board: (board (rectangle 20 6))  // three 6-row layers + 2 separator rows,
//          rows 0–5 = ground, 7–12 = sky, 14–19 = space (separators at 6,13).
//   Within-layer moves: keep the Stage-A directions but CONSTRAIN every (to) to
//          the mover's current layer region (sites of the same 6-row block), so a
//          2-step move can't bleed across a separator into the next layer.
//   Lift step: a piece on a lift cell (the 4 lift columns) may move to the same
//          (col,row-within-layer) on an adjacent layer = (ahead (from) steps:7 N)
//          / steps:7 S, gated (is Empty (to)). [3DTTT] uses exactly (ahead (site)
//          steps:N N) to express vertical neighbours in the flattened board.
//   Per-layer flags (3 each) + Nexus: regions per layer; capture-latch via
//          (set State ...) or removing a neutral Flag marker; Nexus win =
//          Captain on space(3,3) AFTER all 3 enemy flags gone (gate end on the
//          three latches).
//   Promotion: far row of ANY layer = union of the three layers' far rows.
//   Turn limit 180 + §7 tiebreakers (now implemented in the TS engine,
//          RULES.md §6) — model (end) with the 5-step comparison, or accept a
//          flat draw in the GGP spec and document the divergence.
//
// Build Stage A to compile + match a 1-layer perft FIRST, then layer in B.
// ============================================================================
