{
  "name": "skyflag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-routes.mjs",
    "check:render": "node scripts/check-render-invariants.mjs",
    "check:funnel": "node scripts/check-funnel-invariants.mjs",
    "check": "npm run check:render && npm run check:funnel",
    "analyze": "tsx ai-research/analyze.ts",
    "selfplay": "tsx scripts/selfplay.ts",
    "selfplay:shards": "tsx scripts/selfplay-shards.ts",
    "label-deep": "tsx scripts/label-deep.ts",
    "nnue-train": "tsx scripts/nnue-train.ts",
    "nnue:parity": "tsx scripts/nnue-accum-parity.ts",
    "texel": "tsx scripts/texel-tune.ts",
    "pst-fit": "tsx scripts/pst-fit.ts",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.4",
    "@supabase/supabase-js": "^2.105.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge": "^1.3.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
